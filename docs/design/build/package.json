{
  "name": "aegisdesk-design-doc",
  "private": true,
  "description": "Builds the Word design documents in docs/ and their diagrams (docs tooling only).",
  "type": "module",
  "scripts": {
    "diagrams": "node render_diagrams.mjs ../diagrams && node render_diagrams.mjs ../diagrams-production",
    "doc": "node build_hld.mjs && node build_production.mjs",
    "hld": "node render_diagrams.mjs ../diagrams && node build_hld.mjs",
    "production": "node render_diagrams.mjs ../diagrams-production && node build_production.mjs",
    "all": "npm run diagrams && npm run doc"
  },
  "dependencies": {
    "docx": "9.5.1",
    "mermaid": "11.12.0",
    "playwright-core": "1.56.0"
  }
}
