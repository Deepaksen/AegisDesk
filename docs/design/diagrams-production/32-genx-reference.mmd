flowchart TB
  subgraph CP["GenX control plane"]
    direction LR
    portal["Developer portal<br/><small>templates · onboarding</small>"] ~~~ reg["Registries<br/><small>Lyzr · API hub · Credo</small>"] ~~~ pol["Policy and config<br/><small>packs · prompts · budgets</small>"] ~~~ rel["Release<br/><small>CI/CD · GitOps</small>"]
  end
  subgraph UC["Use-case workloads"]
    direction LR
    u1["AegisDesk"] ~~~ u2["HR onboarding agent"] ~~~ u3["Finance close agent"]
  end
  subgraph SVC["Shared services per cell"]
    direction LR
    mg["Model gateway"] ~~~ ctx["Context · memory<br/>RAG"] ~~~ gov["Policy gateway<br/>audit"] ~~~ wf["Workflow<br/>workers"]
  end
  subgraph OPS["Operate"]
    direction LR
    ar["Arize"] ~~~ fin["FinOps"] ~~~ sec["Zscaler · Astrix<br/>Veza"] ~~~ rb["Rubrik"]
  end
  CP -- "register · configure · deploy" --> UC
  UC -- "use through the GenX SDK" --> SVC
