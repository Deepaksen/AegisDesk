flowchart TB
  pr["Prompt change in git<br/><small>pull request, reviewed like code</small>"] --> ev["Eval gates + Arize experiment<br/><small>new version vs current</small>"]
  ev --> ver["Versioned release<br/><small>e.g. router v5, label prod</small>"]
  ver --> pub["Publish to each cloud's prompt store"]
  pub --> g["Vertex AI<br/>prompt management"]
  pub --> a["Bedrock<br/>Prompt Management"]
  pub --> z["Microsoft Foundry"]
  g --> rt["Runtime resolves name + label<br/><small>cached · checksum verified</small>"]
  a --> rt
  z --> rt
  ver -. "bundled fallback in the image" .-> rt
  class pr,ver,pub,rt core
  class ev vendor
  class g,a,z cloud
