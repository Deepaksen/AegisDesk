flowchart LR
  subgraph V["1 · Verify"]
    direction TB
    a1["Lint · types · tests"] --> a2["Eval gates<br/><small>golden · adversarial<br/>reliability · RAG</small>"]
  end
  subgraph B["2 · Build once"]
    direction TB
    b1["Container image<br/><small>SBOM · provenance</small>"] --> b2["Scan image<br/>and dependencies"]
  end
  subgraph A["3 · Assure"]
    direction TB
    c1["Deploy to ephemeral<br/>staging"] --> c2["Zscaler red teaming<br/><small>behavioural regression</small>"] --> c3["Credo AI gate<br/><small>evidence complete?</small>"]
  end
  subgraph R["4 · Release"]
    direction TB
    d1["Sign the digest"] --> d2["Push the same digest<br/><small>GAR · ECR · ACR</small>"] --> d3["Register version<br/>in Lyzr"] --> d4["Pin digest in<br/>GitOps repo"]
  end
  V --> B --> A --> R
