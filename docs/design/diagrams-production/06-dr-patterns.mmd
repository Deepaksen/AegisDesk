flowchart LR
  subgraph BR["Backup and restore"]
    direction TB
    br1["Primary<br/><small>serving</small>"] --> br2[("Backups<br/><small>restore on disaster</small>")]
  end
  subgraph WS["Warm standby"]
    direction TB
    ws1["Primary<br/><small>serving</small>"] --> ws2["Standby<br/><small>scaled down,<br/>data replicated</small>"]
  end
  subgraph AA["Active-active"]
    direction TB
    aa1["Cloud A<br/><small>serving</small>"] <--> aa2["Cloud B<br/><small>serving</small>"]
  end
  BR -- "faster recovery, higher cost" --> WS -- "faster recovery, higher cost" --> AA
  class br1,ws1,aa1,aa2 core
  class ws2 muted
  classDef core fill:#E8F0FB,stroke:#2F5597,color:#1F2937
  classDef vendor fill:#FFF4E5,stroke:#C27C0E,color:#1F2937
  classDef cloud fill:#EAF6EE,stroke:#2E7D32,color:#1F2937
  classDef gov fill:#F3EEFA,stroke:#6A3FA0,color:#1F2937
  classDef risk fill:#FDECEC,stroke:#B3261E,color:#1F2937
  classDef muted fill:#F3F4F6,stroke:#6B7280,color:#1F2937
