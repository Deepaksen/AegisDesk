# Copy to .env and adjust. .env is git-ignored; never commit real keys.

AEGIS_ENV=development

# One of: fake | anthropic | ollama
# "fake" is offline and deterministic; use it for tests and first runs.
MODEL_PROVIDER=fake
# Must be allowlisted for the provider in config/models.yaml.
#   fake:      fake-scripted
#   anthropic: claude-haiku-4-5-20251001 | claude-sonnet-5-5
#   ollama:    llama3.2 | qwen2.5:7b
MODEL_NAME=fake-scripted
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# Hard limits for one agent request
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
# Extra specialist tasks the supervisor accepts from handoffs per turn
AGENT_MAX_HANDOFFS=2

# Where LangGraph stores conversation threads
CHECKPOINT_DB_PATH=.aegisdesk/checkpoints.sqlite

# Knowledge base (RAG)
# hash: offline deterministic embedder (tests, CI) | ollama: EMBEDDING_MODEL via Ollama
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=nomic-embed-text
# memory: rebuilt in every process | pgvector: persistent (docker compose up -d postgres)
VECTOR_STORE=memory
DATABASE_URL=postgresql+psycopg://aegisdesk:aegisdesk@localhost:5432/aegisdesk
RAG_TOP_K=4
# RAG_MIN_SCORE=   # unset: the embedder's calibrated default

# Tools over MCP (Milestone 5)
# local | mcp_inprocess (MCP protocol, no network) | mcp_http (needs `aegisdesk mcp serve`)
TOOL_TRANSPORT=local
# Signs delegation tokens; host and servers must share it for mcp_http (32+ chars)
# MCP_TOKEN_SECRET=
MCP_READ_URL=http://127.0.0.1:8765/read/mcp
MCP_ACTION_URL=http://127.0.0.1:8765/action/mcp
MCP_TIMEOUT_SECONDS=10

# Governance (Milestone 6)
# POLICY_PATH=   # default: config/policy.yaml in the repository
# memory (per process) | postgres (append-only audit_events; needs DATABASE_URL + alembic upgrade head)
AUDIT_STORE=memory

# Anthropic only
ANTHROPIC_API_KEY=

# Ollama only
OLLAMA_BASE_URL=http://localhost:11434
