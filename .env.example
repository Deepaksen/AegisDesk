# Copy to .env and adjust. .env is git-ignored; never commit real keys.

AEGIS_ENV=development

# One of: fake | anthropic | ollama
# "fake" is offline and deterministic; use it for tests and first runs.
MODEL_PROVIDER=fake
# Must be allowlisted for the provider in config/models.yaml.
#   fake:      fake-scripted
#   anthropic: claude-haiku-4-5-20251001 | claude-sonnet-5-5
#   ollama:    llama3.2 | qwen2.5:7b
MODEL_NAME=fake-scripted
MODEL_TEMPERATURE=0.0
MODEL_MAX_TOKENS=1024
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2

# Hard limits for one agent request
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
# Extra specialist tasks the supervisor accepts from handoffs per turn
AGENT_MAX_HANDOFFS=2

# Where LangGraph stores conversation threads
CHECKPOINT_DB_PATH=.aegisdesk/checkpoints.sqlite

# Knowledge base (RAG)
# hash: offline deterministic embedder (tests, CI) | ollama: EMBEDDING_MODEL via Ollama
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=nomic-embed-text
# memory: rebuilt in every process | pgvector: persistent (docker compose up -d postgres)
VECTOR_STORE=memory
DATABASE_URL=postgresql+psycopg://aegisdesk:aegisdesk@localhost:5432/aegisdesk
RAG_TOP_K=4
# RAG_MIN_SCORE=   # unset: the embedder's calibrated default

# Tools over MCP (Milestone 5)
# local | mcp_inprocess (MCP protocol, no network) | mcp_http (needs `aegisdesk mcp serve`)
TOOL_TRANSPORT=local
# Signs delegation tokens; host and servers must share it for mcp_http (32+ chars)
# Required for docker compose (mcp + api) and mcp_http: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# MCP_TOKEN_SECRET=
MCP_READ_URL=http://127.0.0.1:8765/read/mcp
MCP_ACTION_URL=http://127.0.0.1:8765/action/mcp
MCP_TIMEOUT_SECONDS=10

# Governance (Milestone 6)
# POLICY_PATH=   # default: config/policy.yaml in the repository
# memory (per process) | postgres (append-only audit_events; needs DATABASE_URL + alembic upgrade head)
AUDIT_STORE=memory

# Human approval (Milestone 7). For approvals that survive restarts and are shared
# between processes, use postgres for both (then: uv run aegisdesk db init).
DATA_STORE=memory
CHECKPOINT_STORE=sqlite
APPROVAL_TTL_HOURS=168

# Observability (Milestone 8)
# none | tree (print span trees) | console | otlp (docker compose --profile observability)
TELEMETRY_EXPORTER=none
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_FORMAT=text          # text | json (trace_id, request_id, thread_id on every line)
LOG_LEVEL=WARNING
# LangSmith (optional; content is redacted before it is sent)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=aegisdesk
# Deliberate failures for the debugging exercise, e.g. tool_error:get_my_assets
# AEGIS_FAULTS=

# Evaluations (Milestone 9): optional LLM judge for `aegisdesk eval golden --judge`.
# Must be on the model allowlist; without both, the judge is reported as "not run".
# EVAL_JUDGE_PROVIDER=anthropic
# EVAL_JUDGE_MODEL=claude-sonnet-5-5

# Anthropic only
ANTHROPIC_API_KEY=

# Ollama only
OLLAMA_BASE_URL=http://localhost:11434

# API + UI (Milestone 10)
# AEGIS_API_URL=http://127.0.0.1:8000     # where the Streamlit UI finds the API
# GRAFANA_URL=http://localhost:3000       # UI links trace IDs to Grafana Explore (Tempo)
